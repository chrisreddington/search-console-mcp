#!/bin/sh
# Launches the stdio MCP server. Self-locating, so it works when invoked by
# absolute path, from any working directory, or via a plugin host.
set -eu

PLUGIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -d "$PLUGIN_DIR/node_modules" ]; then
  echo "Search Console MCP has no dependencies installed. Run: (cd $PLUGIN_DIR && npm ci && npm run build)" >&2
  exit 1
fi

if [ ! -f "$PLUGIN_DIR/dist/src/server.js" ]; then
  echo "Search Console MCP is not built. Run: (cd $PLUGIN_DIR && npm run build)" >&2
  exit 1
fi

# GUI-launched hosts (Codex.app, Claude Desktop) never source a shell profile,
# so their children get a minimal PATH such as /usr/bin:/bin:/usr/sbin:/sbin.
# Node installed via Homebrew or a version manager is invisible there, so look
# in the usual places before giving up.
find_node() {
  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi
  for candidate in \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    /opt/local/bin/node \
    "$HOME/.local/bin/node" \
    "$HOME/.volta/bin/node" \
    "$HOME/.nvm/versions/node"/*/bin/node
  do
    [ -x "$candidate" ] && { echo "$candidate"; return 0; }
  done
  return 1
}

NODE=$(find_node) || {
  echo "Search Console MCP could not find node. Searched PATH ($PATH) and the usual install locations. A GUI-launched app starts with a minimal PATH, so a Homebrew or version-manager install can be invisible to it." >&2
  exit 1
}

exec "$NODE" "$PLUGIN_DIR/dist/src/server.js"
