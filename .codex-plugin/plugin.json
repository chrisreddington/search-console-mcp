{
  "name": "search-console-mcp",
  "version": "0.10.0",
  "description": "Read-only Google Search Console analysis and URL inspection for Codex.",
  "author": {
    "name": "Chris Reddington"
  },
  "repository": "https://github.com/chrisreddington/search-console-mcp",
  "license": "MIT",
  "keywords": ["seo", "search-console", "google", "analytics", "mcp"],
  "skills": "./skills/",
  "interface": {
    "displayName": "Google Search Console",
    "shortDescription": "Analyze search performance and indexing.",
    "longDescription": "Query Google Search Console performance, sites, sitemaps, and indexed URL status through a local read-only MCP server.",
    "developerName": "Chris Reddington",
    "category": "Developer Tools",
    "capabilities": ["Read"],
    "defaultPrompt": [
      "Analyze my Search Console performance and recommend priorities.",
      "Inspect a URL and explain its indexing status."
    ],
    "brandColor": "#1A73E8",
    "composerIcon": "./assets/icon.svg",
    "logo": "./assets/icon.svg",
    "logoDark": "./assets/icon-dark.svg",
    "screenshots": []
  },
  "mcpServers": {
    "search-console": {
      "command": "./bin/search-console-mcp",
      "cwd": ".",
      "env_vars": [
        "GSC_SECRET_PROVIDER",
        "GSC_SECRET_DOTENV_PATH",
        "GSC_OAUTH_CLIENT_FILE",
        "GSC_CLIENT_ID",
        "GSC_CLIENT_SECRET",
        "GSC_TOKEN_PROVIDER",
        "GSC_TOKEN_FILE",
        "GSC_TOKEN_DOTENV_PATH"
      ]
    }
  }
}
