# Copy to .env only if you use the dotenv provider. Never commit real values.

# --- where the OAuth client id and secret come from --------------------------
# One of: file (default), env, dotenv.
GSC_SECRET_PROVIDER=file

# --- file provider -----------------------------------------------------------
# The Desktop client JSON downloaded from Google Cloud console. Keep it outside
# this repository.
GSC_OAUTH_CLIENT_FILE=/absolute/path/to/google-oauth-desktop-client.json

# --- env provider ------------------------------------------------------------
# GSC_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GSC_CLIENT_SECRET=

# --- dotenv provider ---------------------------------------------------------
# Reads GSC_CLIENT_ID and GSC_CLIENT_SECRET from a dotenv file. This is how a
# 1Password Environment supplies them: the app mounts a .env backed by a named
# pipe, so values are served on read and never written to disk.
# GSC_SECRET_DOTENV_PATH=~/.config/search-console-mcp/.env

# --- where the refresh token is read from ------------------------------------
# One of: file (default), dotenv.
#
# dotenv reads GSC_REFRESH_TOKEN from the same mount as the client credentials,
# so the whole grant lives in one 1Password Environment and never touches disk.
# The mount serves reads only, so a rotated token has to be updated by hand —
# rare, because Google does not rotate desktop-client refresh tokens per refresh.
GSC_TOKEN_PROVIDER=file

# file provider only. A location, not a secret. Written atomically, mode 0600.
GSC_TOKEN_FILE=~/.config/search-console-mcp/token.json

# dotenv provider only. Defaults to GSC_SECRET_DOTENV_PATH.
# GSC_TOKEN_DOTENV_PATH=~/.config/search-console-mcp/.env

# --- where `npm run auth` puts a new grant -----------------------------------
# Set this to a 1Password Environment name and authorization writes the refresh
# token straight into it over stdio, so the grant never touches disk. Leave it
# unset to fall back to GSC_TOKEN_FILE.
# Only `npm run auth` uses this. The server never writes anything.
# GSC_TOKEN_OP_ENVIRONMENT=search-console-mcp

# Path to the 1Password MCP server, if it is not in the default location.
# GSC_OP_MCP_COMMAND=/Applications/1Password.app/Contents/MacOS/onepassword-mcp
