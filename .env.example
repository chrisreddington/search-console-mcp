# Copy to .env only if you use the dotenv provider. Never commit real values.
#
# Where the OAuth token is written. Not a secret, but keep it outside the repo.
GSC_TOKEN_FILE=~/.config/search-console-mcp/token.json

# Which backend supplies the OAuth Desktop client id and secret.
# One of: file (default), env, dotenv, 1password, keychain, doppler.
GSC_SECRET_PROVIDER=file

# --- file provider -----------------------------------------------------------
# Path to the Desktop client JSON downloaded from Google Cloud console.
GSC_OAUTH_CLIENT_FILE=/absolute/path/to/google-oauth-desktop-client.json

# --- env and dotenv providers ------------------------------------------------
# GSC_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GSC_CLIENT_SECRET=
# Only for the dotenv provider; defaults to .env in the working directory.
# GSC_SECRET_DOTENV_PATH=~/.config/search-console-mcp/.env

# --- 1password provider ------------------------------------------------------
# The item must expose "client_id" and "client_secret" fields.
# GSC_SECRET_OP_VAULT=Private
# GSC_SECRET_OP_ITEM=Search Console

# --- keychain provider (macOS, Linux) ----------------------------------------
# macOS:  security add-generic-password -s search-console-mcp -a GSC_CLIENT_ID -w '<value>'
# Linux:  secret-tool store --label='Search Console' service search-console-mcp account GSC_CLIENT_ID

# --- doppler provider --------------------------------------------------------
# Reads GSC_CLIENT_ID and GSC_CLIENT_SECRET from the active Doppler config.
