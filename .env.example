# Copy to .env only if you use the dotenv provider. Never commit real values.

# --- where the OAuth client id and secret come from --------------------------
# One of: file (default), env, dotenv.
GSC_SECRET_PROVIDER=file

# --- file provider -----------------------------------------------------------
# The Desktop client JSON downloaded from Google Cloud console. Keep it outside
# this repository.
GSC_OAUTH_CLIENT_FILE=/absolute/path/to/google-oauth-desktop-client.json

# --- env provider ------------------------------------------------------------
# GSC_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GSC_CLIENT_SECRET=

# --- dotenv provider ---------------------------------------------------------
# Reads GSC_CLIENT_ID and GSC_CLIENT_SECRET from a dotenv file. This is how a
# 1Password Environment supplies them: the app mounts a .env backed by a named
# pipe, so values are served on read and never written to disk.
# GSC_SECRET_DOTENV_PATH=~/.config/search-console-mcp/.env

# --- where the OAuth token is written ----------------------------------------
# A location, not a secret. Written atomically with mode 0600.
GSC_TOKEN_FILE=~/.config/search-console-mcp/token.json
