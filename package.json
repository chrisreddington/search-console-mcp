{
  "name": "search-console-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "Read-only Google Search Console MCP server and Codex skill.",
  "author": "Chris Reddington",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisreddington/search-console-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "auth": "npm run build && node dist/src/auth-cli.js",
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/src/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "google-auth-library": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
